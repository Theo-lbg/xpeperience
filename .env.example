# Copiez ce fichier en « .env » et adaptez-le. Le fichier .env n'est JAMAIS versionné (voir .gitignore).

# Adresse publique du serveur, avec HTTPS. Obligatoire : elle sert à sécuriser le cookie de session.
XPEPERIENCE_PUBLIC_URL=https://xpeperience.exemple.fr

# Seulement avec docker-compose.caddy.yml : le nom de domaine (sans https://).
XPEPERIENCE_DOMAIN=xpeperience.exemple.fr

# Facultatif : code demandé pour créer le premier administrateur.
# Laissez vide pour en générer un aléatoire, affiché dans « docker compose logs xpeperience » au premier démarrage.
XPEPERIENCE_SETUP_CODE=

# Facultatif : autres noms d'hôte acceptés (séparés par des virgules).
XPEPERIENCE_ALLOWED_HOSTS=

# Facultatif : image à utiliser (par défaut celle de la release GitHub) et port local exposé.
# XPEPERIENCE_IMAGE=ghcr.io/theo-lbg/xpeperience:latest
# XPEPERIENCE_HOST_PORT=8080
